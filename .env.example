# ============================================================
# FICHIER TEMPLATE — Copier ce fichier en .env et remplir les valeurs
# NE PAS committer le fichier .env sur Git !
# cp .env.example .env
# ============================================================

# --- PostgreSQL ---
POSTGRES_DB=assoue_db
POSTGRES_USER=assoue_user
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_PORT=5432

# --- Spring Boot ---
# Ne pas modifier, le profil dev est utilisé dans Docker
SPRING_PROFILES_ACTIVE=dev

# --- JWT (générer une clé aléatoire sécurisée) ---
# Exemple de génération : openssl rand -base64 32
JWT_SECRET=change_me_generate_a_secure_key

# --- PayDunya (paiement mobile — Orange Money / Moov Burkina) ---
# Récupérer les clés sur : https://app.paydunya.com/sandbox/api-keys
PAYDUNYA_MASTER_KEY=
PAYDUNYA_PRIVATE_KEY=
PAYDUNYA_TOKEN=
PAYDUNYA_MODE=test
