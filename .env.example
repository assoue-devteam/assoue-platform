POSTGRES_DB=assoue_db
POSTGRES_USER=assoue
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# Générer avec : -join ((1..64)|ForEach-Object{'{0:X2}'-f(Get-Random -Max 256)})
JWT_SECRET=replace-with-a-long-random-secret-min-64-chars
JWT_EXPIRATION_MS=86400000

PAYDUNYA_MODE=test
PAYDUNYA_MASTER_KEY=
PAYDUNYA_PRIVATE_KEY=
PAYDUNYA_TOKEN=
PAYDUNYA_CALLBACK_URL=
PAYDUNYA_RETURN_URL=
PAYDUNYA_CANCEL_URL=
PAYDUNYA_STORE_NAME=AS'Soué

# Dossier des images uploadées (relatif accepté en dev ; ABSOLU obligatoire en
# production, avec un volume monté — voir README « Images uploadées »).
ASSOUE_IMAGES_DIR=./uploads

# ─── Mail SMTP (mot de passe oublié, alertes) ────────────────────────────────
# Pour Brevo : host=smtp-relay.brevo.com, port=587, username=ton-email-brevo
# Pour Gmail : host=smtp.gmail.com, port=587, username=ton@gmail.com + App Password
ASSOUE_MAIL_HOST=localhost
ASSOUE_MAIL_PORT=25
ASSOUE_MAIL_PROTOCOL=smtp
ASSOUE_MAIL_USERNAME=
ASSOUE_MAIL_PASSWORD=
ASSOUE_MAIL_FROM=no-reply@assoue.bf
# Destinataires des alertes métier (une ou plusieurs adresses, séparées par des virgules).
ASSOUE_MAIL_ALERTES_DESTINATAIRES=alertes@assoue.bf

# ─── Système de points & récompenses signalements ──────────────────────────────
ASSOUE_POINTS_ACTIF=true

# ─── Sécurité mot de passe oublié ────────────────────────────────────────────
# Générer avec : -join ((1..32)|ForEach-Object{'{0:X2}'-f(Get-Random -Max 256)})
# OBLIGATOIRE en production — ne jamais laisser la valeur par défaut !
ASSOUE_MOTDEPASSE_CLE_HMAC=cle-hmac-dev-a-remplacer-en-production
